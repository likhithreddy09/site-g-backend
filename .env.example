MONGO_URI=mongodb://localhost:27017
MONGO_DB=siteguard
SECRET_KEY=change-me-to-a-long-random-string
# Optional Fernet key for encrypting API secrets (derived from SECRET_KEY if empty)
ENCRYPTION_KEY=

PUBLIC_API_URL=http://localhost:5050
APP_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# Run scheduler inside the API process (set false and run worker.py separately in production)
EMBED_WORKER=true
HTTP_WORKERS=16
BROWSER_WORKERS=2

# NEVER enable in production — allows monitoring localhost/private networks
ALLOW_PRIVATE_TARGETS=false

# Railway/Railpack: install Playwright browser binaries during build
RAILPACK_PYTHON_PLAYWRIGHT_INSTALL=1

# Local working cache for screenshots (also persisted to MongoDB GridFS for durability)
# STORAGE_DIR=./storage

# Email (if SMTP_HOST is empty, emails are logged to the console and recorded as "logged")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Watchfront <alerts@example.com>
SMTP_TLS=true

# Optional LLM for AI diagnosis (falls back to the built-in evidence-based engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cashfree Payment Gateway — hosted web checkout
# Docs: https://www.cashfree.com/docs/payments/online/web/redirect
# Dashboard: whitelist https://watchfront.in + set webhook to {PUBLIC_API_URL}/api/billing/webhook
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
# Payment methods shown on checkout (comma-separated). Blank = all methods enabled on account.
# Options: cc,dc,upi,nb,app,paylater,ccc,ppc,emi,cardlessemi,ccemi,dcemi,banktransfer,applepay,paypal
CASHFREE_PAYMENT_METHODS=cc,dc,upi,nb,app,paylater

# Required for Cashfree return_url / notify_url (must be https in production)
# PUBLIC_API_URL=https://site-g-backend-production.up.railway.app
# APP_URL=https://watchfront.in
